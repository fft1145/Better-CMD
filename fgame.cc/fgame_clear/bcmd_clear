    cout << "    2. 双击运行 mpam-fe.exe 更新Defender病毒库" << endl;
    cout << "    3. 重启电脑以完成IE移除操作" << endl;
    cout << "    4. 在Windows安全中心确认Defender已启用实时保护" << endl;
