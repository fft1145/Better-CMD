/* ================================================================
 * 全局进度条状态
 * ================================================================ */
static atomic<int>  g_progress(0);    // 0~100
static atomic<bool> g_finished(false); // 当前任务是否完成
static string       g_taskName("");    // 当前任务名称
static atomic<bool> g_hasRealProgress(false); // 是否有真实进度(下载)

/* ================================================================
 * 辅助函数
 * ================================================================ */

// 检查是否以管理员身份运行
static bool IsRunAsAdmin()
{
    BOOL  fRet = FALSE;
    HANDLE hToken = NULL;
    if (OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &hToken)) {
        TOKEN_ELEVATION elev;
        DWORD cbSize = sizeof(elev);
        if (GetTokenInformation(hToken, TokenElevation,
                                &elev, sizeof(elev), &cbSize)) {
            fRet = elev.TokenIsElevated;
        }
        CloseHandle(hToken);
    }
    return fRet != FALSE;
}

// 以管理员身份重新启动本程序
static bool RelaunchAsAdmin()
{
    char szPath[MAX_PATH];
    if (!GetModuleFileNameA(NULL, szPath, MAX_PATH))
        return false;

    SHELLEXECUTEINFOA sei;
    ZeroMemory(&sei, sizeof(sei));
    sei.cbSize = sizeof(sei);
    sei.lpVerb = "runas";
    sei.lpFile = szPath;
    sei.nShow  = SW_SHOWNORMAL;
    return ShellExecuteExA(&sei) != FALSE;
}

// 打印分隔线
static void PrintSeparator(char ch = '=', int len = 56)
{
    string s(len, ch);
    cout << s << endl;
}

/* ================================================================
 * 进度条显示线程
 *   格式: 正在XXX（还需Ns）：##........     20%
 * ================================================================ */
static void ProgressThread(int estimatedSeconds)
{
    auto startTime = chrono::steady_clock::now();

    while (!g_finished.load()) {
        int p = g_progress.load();
        if (p < 0)   p = 0;
        if (p > 100) p = 100;

        // 计算剩余时间
        int remain;
        auto elapsed = (int)chrono::duration_cast<chrono::seconds>(
            chrono::steady_clock::now() - startTime).count();

        if (g_hasRealProgress.load() && p > 0 && p < 100) {
            // 有真实进度: 根据百分比反推剩余时间
            remain = (int)(estimatedSeconds * (100 - p) / 100);
        } else if (p >= 100) {
            remain = 0;
        } else {
            // 无真实进度: 按时间估算
            remain = estimatedSeconds - elapsed;
            if (remain < 0) remain = 0;
        }

        // 构建进度条字符串
        cout << "\r" << "正在" << g_taskName
             << "（还需" << remain << "s）：" << flush;

        int filled = p / 10;          // 填充的#数量 (0~10)
        if (p == 100) filled = 10;
        for (int j = 0; j < 10; j++)
            cout << (j < filled ? '#' : '.');

        // 百分比 (右对齐3位)
        cout << "     ";
        if (p < 100) cout << " ";       // 补齐对齐
        cout << p << "%  " << flush;

        this_thread::sleep_for(chrono::milliseconds(150));
    }

    // 最终显示100%
    cout << "\r" << "正在" << g_taskName << "（还需0s）：" << flush;
    for (int j = 0; j < 10; j++) cout << '#';
    cout << "     100%  [完成]" << endl;
}

// 在进度条线程中执行某个任务
static void RunWithProgress(const string& task,
                            int estSeconds,
                            function<void()> work)
{
    g_taskName        = task;
    g_progress        = 0;
    g_finished        = false;
    g_hasRealProgress = false;

    thread t(ProgressThread, estSeconds);
    work();                 // 在主线程执行实际工作
    g_finished = true;
    t.join();

    g_progress = 0;
    g_hasRealProgress = false;
}

/* ================================================================
 * 下载回调类 - 实现IBindStatusCallback以获取真实下载进度
 * ================================================================ */
class DownloadCallback : public IBindStatusCallback
{
public:
    // IUnknown
    HRESULT STDMETHODCALLTYPE QueryInterface(REFIID riid, void** ppv) override
    {
        if (riid == IID_IUnknown || riid == IID_IBindStatusCallback) {
            *ppv = static_cast<IBindStatusCallback*>(this);
            return S_OK;
        }
        *ppv = nullptr;
        return E_NOINTERFACE;
    }
    ULONG STDMETHODCALLTYPE AddRef() override  { return 1; }
    ULONG STDMETHODCALLTYPE Release() override { return 1; }

    // IBindStatusCallback
    HRESULT STDMETHODCALLTYPE OnStartBinding(DWORD, IBinding*) override
    { return S_OK; }

    HRESULT STDMETHODCALLTYPE GetPriority(LONG* pnPriority) override
    { *pnPriority = THREAD_PRIORITY_NORMAL; return S_OK; }

    HRESULT STDMETHODCALLTYPE OnLowResource(DWORD) override
    { return S_OK; }

    HRESULT STDMETHODCALLTYPE OnProgress(ULONG ulProgress,
                                         ULONG ulProgressMax,
                                         ULONG /*ulStatusCode*/,
                                         LPCWSTR /*szStatusText*/) override
    {
        if (ulProgressMax > 0) {
            // 有Content-Length: 计算真实百分比
            int p = (int)((ULONGLONG)ulProgress * 100 / ulProgressMax);
            g_progress = p;
            g_hasRealProgress = true;
        } else if (ulProgress > 0) {
            // 无Content-Length: 按已下载量粗略估算
            int mb = (int)(ulProgress / (1024 * 1024));
            int p = mb * 5;     // 每MB算5%
            if (p > 95) p = 95;
            g_progress = p;
        }
        return S_OK;
    }

    HRESULT STDMETHODCALLTYPE OnStopBinding(HRESULT, LPCWSTR) override
    { return S_OK; }

    HRESULT STDMETHODCALLTYPE GetBindInfo(DWORD* pgrfBINDF,
                                          BINDINFO* pbindinfo) override
    {
        if (pgrfBINDF) *pgrfBINDF = 0;
        if (pbindinfo) {
            pbindinfo->cbSize    = sizeof(BINDINFO);
            pbindinfo->dwBindVerb = BINDVERB_GET;
        }
        return S_OK;
    }

    HRESULT STDMETHODCALLTYPE OnDataAvailable(DWORD, DWORD,
                                              FORMATETC*,
                                              STGMEDIUM*) override
    { return S_OK; }

    HRESULT STDMETHODCALLTYPE OnObjectAvailable(REFIID, IUnknown*) override
    { return S_OK; }
};

/* ================================================================
 * 阶段1: 终止360系列进程
 * ================================================================ */
static void Kill360Processes()
{
    vector<string> procs = {
        "360Tray.exe",          // 360安全卫士托盘
        "360safe.exe",          // 360安全卫士主程序
        "ZhuDongFangYu.exe",   // 360主动防御
        "360sd.exe",            // 360杀毒
        "360se.exe",            // 360安全浏览器
        "360se6.exe",           // 360安全浏览器(新版)
        "360Desktop.exe",       // 360桌面
        "LiveUpdate360.exe",    // 360软件升级
        "360leakfixer.exe",    // 360漏洞修复
        "QHSafeTray.exe",       // 360安全卫士托盘
        "QHActiveDefense.exe",  // 360主动防御服务
        "360wbox.exe",          // 360安全卫士
        "Safemon.exe",          // 360安全卫士监控
        "360zip.exe",           // 360压缩
        "360Soft.exe",          // 360软件管家
        "360Helper.exe",        // 360助手
        "360Speedup.exe",       // 360加速球
        "QHWatchdog.exe",       // 360看门狗
        "360Doctor.exe",        // 360电脑专家
        "360Drift.exe",         // 360驱动大师
        "360SoftMgr.exe",       // 360软件管家
        "QHWatchdog.exe",       // 360安全卫士看门狗
    };

    int total = (int)procs.size();
    for (int i = 0; i < total; i++) {
        string cmd = "taskkill /F /IM \"" + procs[i] + "\" >nul 2>&1";
        system(cmd.c_str());
        g_progress = (i + 1) * 100 / total;
        this_thread::sleep_for(chrono::milliseconds(150));
    }
}

/* ================================================================
 * 阶段2: 卸载360系列软件
 * ================================================================ */
static void Uninstall360Software()
{
    // 方法1: wmic 卸载所有名称含"360"的产品
    system("wmic product where \"name like '%360%'\" call uninstall /nointeractive >nul 2>&1");
    g_progress = 40;
    this_thread::sleep_for(chrono::milliseconds(300));

    // 方法2: PowerShell 兜底 - 查找并卸载
    system("powershell -NoProfile -ExecutionPolicy Bypass -Command "
           "\"Get-WmiObject Win32_Product | Where-Object {$_.Name -like '*360*'} | "
           "ForEach-Object { $_.Uninstall() }\" >nul 2>&1");
    g_progress = 70;
    this_thread::sleep_for(chrono::milliseconds(300));

    // 方法3: 通过注册表卸载字符串卸载
    system("powershell -NoProfile -ExecutionPolicy Bypass -Command "
           "\"Get-ItemProperty 'HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*',"
           "'HKLM:\\SOFTWARE\\WOW6432Node\\Microsoft\\Windows\\CurrentVersion\\Uninstall\\*' "
           "-ErrorAction SilentlyContinue | Where-Object {$_.DisplayName -like '*360*'} | "
           "ForEach-Object { if ($_.UninstallString) { Start-Process cmd.exe -ArgumentList '/c', "
           "$_.UninstallString, '/SILENT', '/NORESTART' -Wait -NoNewWindow } }\" >nul 2>&1");
    g_progress = 100;
}

/* ================================================================
 * 阶段3: 移除IE浏览器
 * ================================================================ */
static void RemoveIE()
{
    // 方法1: DISM 禁用IE可选功能
    system("dism /online /Disable-Feature /FeatureName:Internet-Explorer-Optional-* "
           "/Quiet /NoRestart >nul 2>&1");
    g_progress = 50;
    this_thread::sleep_for(chrono::milliseconds(500));

    // 方法2: PowerShell 兜底
    system("powershell -NoProfile -ExecutionPolicy Bypass -Command "
           "\"Disable-WindowsOptionalFeature -Online "
           "-FeatureName 'Internet-Explorer-Optional-*' -NoRestart "
           "-ErrorAction SilentlyContinue\" >nul 2>&1");
    g_progress = 100;
}

/* ================================================================
 * 阶段4: 下载最新版 Microsoft Edge (Stable)
 * ================================================================ */
static void DownloadEdge()
{
    // Microsoft Edge Stable 在线安装器 (自动检测32位)
    const char* url =
        "https://c2rsetup.officeapps.live.com/c2r/downloadEdge.aspx"
        "?platform=Default&source=EdgeStablePage&Channel=Stable"
        "&language=zh-cn&brand=M100";
    const char* savePath = "MicrosoftEdgeSetup.exe";

    DeleteFileA(savePath);  // 删除旧文件

    DownloadCallback callback;
    HRESULT hr = URLDownloadToFileA(NULL, url, savePath, 0, &callback);

    if (FAILED(hr)) {
        cout << "\n[警告] Edge下载失败 (错误码: 0x" << hex << hr << ")" << endl;
        cout << "  请手动访问 https://www.microsoft.com/edge 下载" << endl;
    }
    g_progress = 100;
}

/* ================================================================
 * 阶段5: 下载最新版 Windows Defender 安全智能更新 (x86)
