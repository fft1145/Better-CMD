static void DownloadDefenderUpdate()
{
    // Windows Defender 病毒库更新包 (32位/x86)
    // 来源: https://www.microsoft.com/en-us/wdsi/defenderupdates
    const char* url =
        "https://go.microsoft.com/fwlink/?LinkID=121721&arch=x86";
    const char* savePath = "mpam-fe.exe";

    DeleteFileA(savePath);  // 删除旧文件

    DownloadCallback callback;
    HRESULT hr = URLDownloadToFileA(NULL, url, savePath, 0, &callback);

    if (FAILED(hr)) {
        cout << "\n[警告] Defender更新下载失败 (错误码: 0x" << hex << hr << ")" << endl;
        cout << "  请手动访问 https://www.microsoft.com/wdsi/defenderupdates 下载" << endl;
    }
    g_progress = 100;
}

